%% ======================
%% FLOWS
%% ======================
Browser -->|"loads SPA"| EntryMain
EntryMain --> App

App -->|"wraps"| AuthContext
App -->|"wraps"| AccessibilityContext
App -->|"uses"| SupabaseClient

App --> Filters
App --> EmployeeSearch
App --> FlightList
FlightList --> FlightCard

App --> EmployeeFlightResult
EmployeeFlightResult --> EmployeeFlightCard

App --> BookingPopUp
BookingPopUp --> ProtectedRoute

App --> CheckoutPage
App --> StripeCheckoutPage

App --> HomePage
App --> SignInPage
App --> CreateAccount
App --> BookingsOverview
App --> SettingsPage
App --> AdminDashboard

App --> Utils

%% ======================
%% CONFIG USAGE
%% ======================
App -->|"build config"| ViteConfig
App -->|"env vars"| Env
App -->|"HTML shell"| IndexHTML
App -->|"static files"| PublicAssets
App -->|"static assets"| Assets

%% ======================
%% PAYMENT FLOW
%% ======================
CheckoutPage -->|"POST /create-checkout"| Server
StripeCheckoutPage -->|"POST /create-checkout"| Server

Server -->|"Stripe SDK"| Stripe
Stripe -.->|"webhook\ncheckout.session.completed"| Server

Server -->|"generate receipt"| PDFLib

%% ======================
%% DATABASE ACCESS
%% ======================
SupabaseClient -->|"RLS reads/writes"| Profiles
SupabaseClient -->|"RLS reads/writes"| Flights
SupabaseClient -->|"RLS reads/writes"| Seats
SupabaseClient -->|"RLS reads/writes"| Bookings
SupabaseClient -->|"RLS reads/writes"| BookingSeats

Server -->|"service-role writes"| Profiles
Server -->|"service-role writes"| Flights
Server -->|"service-role writes"| Seats
Server -->|"service-role writes"| Bookings
Server -->|"service-role writes"| BookingSeats

